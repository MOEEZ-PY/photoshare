# ── Required ──────────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_strong_random_secret

# ── Optional (defaults shown) ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_EXPIRES_IN=24h
DB_PATH=./data/photoshare.db
UPLOAD_DIR=./uploads
MAX_PHOTO_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
